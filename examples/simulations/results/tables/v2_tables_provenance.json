  "pairwise_runs_provenance_note": "The pairwise FPR and power runs embed no git SHA. Their output mtimes (2026-11-24 23:48 .. 2026-11-25 13:42) lie between commits e2d92c6 (2026-11-24 23:40) / 41661f5 (2026-11-25 13:44) and precede c3245f2 (2026-11-27 00:43), which flipped the compute_p_val / compute_p_val_glm default two_tailed=False -> True. Neither runner passes two_tailed=, so these tables are per-tail (directional) results: fwer_max_tail is compared with alpha per tail, fwer_two_sided_bonf (alpha/2 per tail) and fwer_either_at_alpha (expected <= 2*alpha) are the two-sided diagnostics, and NO fwer_two_sided_joint column exists for them.",
  "column_semantics": {
    "fwer_two_sided_joint": "GLM run only (two_tailed=True): share of null runs with any edge of EITHER sign having min(p_pos, p_neg) <= alpha, both p-maps corrected against the joint max-null. This is the FWER of the single two-sided family that the 2.0 contract holds at alpha.",
    "fwer_pos / fwer_neg": "Share of null runs with >= 1 false-positive edge in the positive / negative tail at unadjusted alpha (one-directional families).",
    "fwer_max_tail": "max(fwer_pos, fwer_neg): pairwise max-tail diagnostic, judged against alpha per tail. It is NOT the two-sided joint FWER.",
    "fwer_two_sided_bonf": "Share of null runs with min_p_pos <= alpha/2 or min_p_neg <= alpha/2 (Bonferroni over tails); judged against alpha.",
    "fwer_either_at_alpha": "Share of null runs with any FP in either tail at unadjusted alpha; diagnostic with expected upper bound 2*alpha (= 0.10) under per-tail nulls; equals fwer_two_sided_joint when two_tailed=True.",
    "mean_fpr_total": "Mean proportion of false-positive edges per null run (edge-level, descriptive).",
    "ci_low / ci_high": "95% Clopper-Pearson exact intervals (as in the source summaries)."
  },
